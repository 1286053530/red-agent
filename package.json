{
  "name": "xiaozhu-shujin",
  "version": "2.1.19",
  "description": "筱竹书瑾 · Agent 开发工作台",
  "author": "筱竹书瑾",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "node scripts/python.mjs serve",
    "start": "node scripts/python.mjs serve",
    "desktop": "electron .",
    "build:backend": "node scripts/python.mjs build",
    "dist:win": "npm run build:backend && electron-builder --win nsis portable --config.electronDist=node_modules/electron/dist",
    "test": "node scripts/python.mjs test",
    "test:desktop": "electron tests/desktop-python.mjs"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "main": "desktop/main.mjs",
  "build": {
    "appId": "cn.xiaozhu.shujin",
    "productName": "筱竹书瑾",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "!desktop/**/test-*",
      "!tests/**",
      "!release/**",
      "!.local/**",
      "!test-results/**"
    ],
    "extraResources": [
      {"from":"dist/python/shujin-backend","to":"backend","filter":["**/*"]},
      {"from":".","to":"frontend","filter":["*.html","*.css","app.js","account.js","developer.js"]}
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signExecutable": false,
      "icon": "desktop/icon.ico"
    },
    "nsis": {
      "artifactName": "XiaozhuShujin-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "XiaozhuShujin-${version}-${arch}-Portable.${ext}"
    }
  }
}
